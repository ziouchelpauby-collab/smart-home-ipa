{
  "expo": {
    "name": "Smart Home",
    "slug": "smart-home",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "smarthome",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connects to Home Assistant on your home network.",
        "NSMicrophoneUsageDescription": "Lets you talk through your Blink cameras.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.zak5978.smarthome",
      "appleTeamId": "0000000000",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.zak5978.smarthome.shared"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-app-shortcuts",
      "@bacons/apple-targets",
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos of people so the cameras can recognize them. The photos stay on your Home Assistant.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.zak5978.smarthome.widget",
                  "targetName": "SmartHomeWidget",
                  "entitlements": {
                    "keychain-access-groups": [
                      "$(AppIdentifierPrefix)com.zak5978.smarthome.shared"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.zak5978.smarthome.watch",
                  "targetName": "SmartHomeWatch"
                },
                {
                  "bundleIdentifier": "com.zak5978.smarthome.notification-service",
                  "targetName": "SmartHomeNotification"
                }
              ]
            }
          }
        },
        "projectId": "515a921e-b5b5-445b-9ead-1ea9892dc685"
      }
    }
  }
}
